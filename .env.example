# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL — never use MySQL or XAMPP for this project.
# Either define DATABASE_URL or the individual values below.
# DATABASE_URL=postgresql://soutarah_user:change_me@localhost:5432/soutarah_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soutarah_db
DB_USER=soutarah_user
DB_PASSWORD=change_me
DB_SSL=false

# Reserved for Phase 3 authentication. Use a long random value in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Local development accounts. Type these plain values on the login form;
# the seed command hashes them before saving to PostgreSQL.
SEED_CLIENT_EMAIL=client@soutarah.local
SEED_CLIENT_PHONE=0700000001
SEED_CLIENT_PASSWORD=choose_a_client_password
SEED_ADMIN_EMAIL=admin@soutarah.local
SEED_ADMIN_PHONE=0700000002
SEED_ADMIN_PASSWORD=choose_an_admin_password

# SMTP: optional locally, required to notify the manager by email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=SOUTARAH GROUP <noreply@example.com>
MANAGER_EMAIL=manager@example.com
