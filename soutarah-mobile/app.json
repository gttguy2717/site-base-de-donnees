{
  "expo": {
    "name": "SOUTARAH GROUP",
    "slug": "soutarah-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-soutarah.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0d3b1e",
    "splash": {
      "image": "./assets/logo-soutarah.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d3b1e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.soutarahgroup.mobile"
    },
    "android": {
      "package": "ci.soutarahgroup.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d3b1e",
        "foregroundImage": "./assets/logo-soutarah.png",
        "monochromeImage": "./assets/logo-soutarah.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
