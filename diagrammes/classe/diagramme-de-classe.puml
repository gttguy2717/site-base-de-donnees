@startuml diagramme-de-classe
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam roundcorner 2
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 55
skinparam ranksep 55

hide circle
hide empty fields

skinparam class {
    BackgroundColor white
    BorderColor black
    ArrowColor black
    FontName "Segoe UI"
    FontSize 10.5
    FontStyle bold
    AttributeFontName "Segoe UI"
    AttributeFontSize 9
    AttributeFontStyle normal
}

' ==========================================================
' 1. ACTEURS (UTILISATEURS & SPÉCIALISATIONS)
' ==========================================================

class Utilisateurs {
    + ID_Utilisateur : int
    + Nom : string
    + Prenoms : string
    + Email : string
    + Telephone : string
    + Mot_De_Passe : string
    + Role : enum([Admin],[Particulier],[Entreprise])
    + Est_Actif : boolean
    + Date_Enregistrement : date
    --
    + SeConnecter()
    + SeDeconnecter()
    + ModifierProfil()
}

class Admin {
    + Niveau_Acces : int
    --
    + GestionPlateforme()
    + SuiviFlotte()
    + ValiderDevis()
    + ConsulterStats()
}

class Client_Particulier {
    + Num_Piece_ID : string
    + Adresse : string
    --
    + ReserverVehicule()
    + DemanderDevis()
}

class Client_Entreprise {
    + Raison_Sociale : string
    + Nom_Responsable : string
    + Num_RCCM : string
    + Statut_Verification : string
    --
    + DemanderDevisEntreprise()
    + ObtenirTarifNegocie()
}

Admin --|> Utilisateurs
Client_Particulier --|> Utilisateurs
Client_Entreprise --|> Utilisateurs

' ==========================================================
' 2. PÔLE VÉHICULES & RÉSERVATIONS (FOCUS PROJET)
' ==========================================================

class Vehicules {
    + ID_Vehicule : int
    + Immatriculation : string
    + Marque : string
    + Modele : string
    + Categorie : enum([SUV],[Berline],[PickUp],[4x4],[Utilitaire])
    + Transmission : string
    + Carburant : string
    + Nombre_Places : int
    + Prix_Journalier : float
    + Statut_Disponibilite : boolean
    --
    + VerifierDisponibilite()
    + BloquerDates()
}

class Reservations {
    + ID_Reservation : int
    + Reference : string
    + Date_Debut : date
    + Date_Fin : date
    + Avec_Chauffeur : boolean
    + Montant_Total : float
    + Canal_Origine : enum([Mobile],[Web])
    + Statut : enum([EnAttente],[Confirmee],[Annulee])
    + Date_Reservation : date
    --
    + ConfirmerReservation()
    + SolderReservation()
    + AnnulerReservation()
}

' ==========================================================
' 3. PÔLE NÉGOCE, CATALOGUE & DEVIS
' ==========================================================

class Produits {
    + ID_Produit : int
    + Reference : string
    + Designation : string
    + Description : string
    + Categorie : enum([MaterielBTP],[Equipement],[Fourniture])
    + Prix_Unitaire : float
    + Quantite_Stock : int
    + Seuil_Alerte : int
    --
    + VerifierStock()
    + MettreAJourStock()
}

class Devis {
    + ID_Devis : int
    + Numero_Devis : string
    + Montant_HT : float
    + Montant_TVA : float
    + Montant_TTC : float
    + Date_Emission : date
    + Date_Validite : date
    + Statut : enum([Brouillon],[Emis],[Valide],[Rejete])
    + Fichier_PDF : string
    --
    + CalculerMontantTotal()
    + GenererPDF()
    + ValiderDevis()
}

class Ligne_Devis {
    + ID_Ligne : int
    + Quantite : int
    + Prix_Unitaire : float
    + Sous_Total : float
    --
    + CalculerSousTotal()
}

' ==========================================================
' 4. RÈGLEMENTS & NOTIFICATIONS
' ==========================================================

class Paiements {
    + ID_Paiement : int
    + Ref_Paiement : string
    + Moyen_Paiement : enum([CarteBancaire],[MobileMoney],[EspecesLivraison])
    + Montant : float
    + Statut : enum([EnAttente],[Valide],[Echec])
    + Date_Paiement : date
    --
    + EffectuerPaiement()
    + VerifierPaiement()
}

class Notifications {
    + ID_Notification : int
    + Titre : string
    + Message : string
    + Type_Alerte : string
    + Est_Lu : boolean
    + Date_Envoi : date
    --
    + MarquerCommeLu()
}

' ==========================================================
' RELATIONS (SANS FLÈCHES DANS LES MOTS DE LIAISON)
' ==========================================================

' Utilisateurs vers les modules
Utilisateurs "1  " --> "0..*  " Reservations : Effectue
Utilisateurs "1  " --> "0..*  " Devis : Demande
Utilisateurs "1  " --> "0..*  " Notifications : Reçoit

' Véhicules & Réservations
Reservations "0..*  " --> "1  " Vehicules : Réserve

' Lors de la réservation d'un véhicule, un devis officiel est généré
Reservations "1  " -right-> "1  " Devis : Génère

' Devis & Produits via Composition Lignes de Devis
Devis "1  " *-- "1..*  " Ligne_Devis : Contient
Ligne_Devis "0..*  " --> "1  " Produits : Concerne

' Règlements par Paiement
Reservations "1  " --> "0..1  " Paiements : Règle
Devis "1  " --> "0..1  " Paiements : Règle

@enduml
