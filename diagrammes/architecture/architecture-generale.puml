@startuml architecture-generale
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 10

title 1. Architecture générale du système SOUTARAH GROUP\n<size:12>Plateforme Web & Application Mobile de Réservation de Véhicules</size>

' Définition des styles
skinparam node {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}
skinparam cloud {
    BackgroundColor #F0F9FF
    BorderColor #0284C7
    FontColor #0F172A
}
skinparam database {
    BackgroundColor #F1F5F9
    BorderColor #334155
    FontColor #0F172A
}

package "Clients (Niveau Présentation)" as PKG_CLIENTS {
    node "Ordinateur Portable / Bureau\n<size:10>Plateforme Web (React / Vite)</size>\n<b>Clients & Administration</b>" as WEB #E0F2FE
    node "Smartphone\n<size:10><b>★ Application Mobile Dédiée</b></size>\n<size:10>Réservation Véhicules (React Native / Expo)</size>" as MOBILE #DCFCE7
}

cloud "<b>Internet</b>\n<size:11>Réseau d'échange mondial</size>\n<size:10>JSON / Tokens JWT</size>" as INTERNET

package "Serveur & Données (Niveaux Métier & Données)" as PKG_SERVER {
    node "<b>Serveur d'application (Backend)</b>\n<size:11>Node.js / Express API REST</size>\n<size:10>• Moteur de réservation anti-double réservation\n• Génération automatique des devis PDF\n• Authentification sécurisée JWT</size>" as API #F0FDF4
    database "<b>Base de données relationnelle</b>\n<size:11>MySQL (ORM Sequelize)</size>\n<size:10>• 21 Véhicules du parc officiel\n• Devis, Réservations & Comptes</size>" as DB
}

' Relations
WEB --> INTERNET : HTTPS / REST
MOBILE --> INTERNET : HTTPS / REST (JSON)
INTERNET --> API : Routage API REST
API --> DB : Requêtes SQL (Sequelize)

footer Schéma d'architecture générale 3-tiers distribué • SOUTARAH GROUP
@enduml
